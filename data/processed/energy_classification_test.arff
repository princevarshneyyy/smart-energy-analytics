@attribute weather_condition {Cloudy,Humid,Rain,Sunny}
@attribute consumer_type {Commercial,Industrial,Residential}
@attribute connected_load_kw numeric
@attribute energy_lag_1 numeric
@attribute energy_lag_2 numeric
@attribute energy_rolling_mean_6 numeric
@attribute consumption_class {Low,Normal,High}

